<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Agendar Cita</h2>
                <form action="/create" method="POST">
                    <div class="mb-3">
                        <label for="pet_name" class="form-label">Nombre del Perrito</label>
                        <input type="text" class="form-control" id="pet_name" name="pet_name" required
                            placeholder="Ej: Toby">
                    </div>
                    <div class="mb-3">
                        <label for="owner_name" class="form-label">Nombre del Dueño</label>
                        <input type="text" class="form-control" id="owner_name" name="owner_name" required
                            placeholder="Ej: Carlos Ruiz">
                    </div>
                    <div class="mb-3">
                        <label for="service" class="form-label">Servicio</label>
                        <select class="form-control" id="service" name="service" required>
                            <option value="">Seleccione un servicio...</option>
                            <option value="Baño y Perfume">Baño y Perfume</option>
                            <option value="Corte de Pelo">Corte de Pelo</option>
                            <option value="Limpieza de Oídos">Limpieza de Oídos</option>
                            <option value="Corte de Uñas">Corte de Uñas</option>
                            <option value="Spa Completo">Spa Completo</option>
                            <option value="Consulta Veterinaria">Consulta Veterinaria</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="appointment_date" class="form-label">Fecha y Hora</label>
                        <input type="datetime-local" class="form-control" id="appointment_date" name="appointment_date"
                            required>
                    </div>
                    <div id="campos-medicos">
                        <div class="mb-3">
                            <label for="peso" class="form-label">Peso (kg)</label>
                            <input type="number" step="0.1" class="form-control" id="peso" name="peso" placeholder="Ej: 5.3">
                        </div>
                        <div class="mb-3">
                            <label for="temperatura" class="form-label">Temperatura (°C)</label>
                            <input type="number" step="0.1" class="form-control" id="temperatura" name="temperatura" placeholder="Ej: 38.5">
                        </div>
                        <div class="mb-3">
                            <label for="diagnostico" class="form-label">Diagnóstico</label>
                            <textarea class="form-control" id="diagnostico" name="diagnostico" rows="3" placeholder="Descripción del diagnóstico"></textarea>
                        </div>
                    </div>

                    <script>
                        const servicio = document.getElementById('service');
                        const camposMedicos = document.getElementById('campos-medicos');
                        const inputs = camposMedicos.querySelectorAll('input, textarea');

                        function toggleCamposMedicos() {
                            if (servicio.value === 'Consulta Veterinaria') {
                                camposMedicos.style.display = 'block';
                                inputs.forEach(input => input.setAttribute('required', 'required'));
                            } else {
                                camposMedicos.style.display = 'none';
                                inputs.forEach(input => input.removeAttribute('required'));
                            }
                        }

                        servicio.addEventListener('change', toggleCamposMedicos);
                        toggleCamposMedicos();
                    </script>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Programar Cita</button>
                        <a href="/" class="btn btn-link text-muted">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>